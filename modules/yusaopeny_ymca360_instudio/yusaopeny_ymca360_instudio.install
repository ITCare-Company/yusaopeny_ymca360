<?php

/**
 * @file
 * YUSA OpenY YMCA360 integration installation routines.
 */

/**
 * Implements hook_install().
 */
function yusaopeny_ymca360_instudio_install() {
  $config = \Drupal::configFactory()->getEditable('ymca_sync.settings');
  $active_syncers = $config->get('active_syncers') ?? [];
  $active_syncers[] = 'yusaopeny_ymca360_instudio.syncer';
  $config->set('active_syncers', $active_syncers);
  $config->save();
}

/**
 * Implements hook_install().
 */
function yusaopeny_ymca360_instudio_uninstall() {
  $config = \Drupal::configFactory()->getEditable('ymca_sync.settings');
  $active_syncers = $config->get('active_syncers') ?? [];
  $active_syncers = array_filter($active_syncers, function ($value) {
    return $value !== 'yusaopeny_ymca360_instudio.syncer';
  });
  $config->set('active_syncers', $active_syncers);
  $config->save();
}

/**
 * Exclude syncer-owned node bundles from Trash soft-delete.
 *
 * Reconciliation deletes expired/removed occurrences every run; letting
 * Trash soft-delete them would build an ever-growing backlog. The affected
 * bundles are the ones the syncer creates or references in lockstep:
 * session, activity, class, program, program_subcategory.
 */
function yusaopeny_ymca360_instudio_update_10002(): string {
  if (!\Drupal::moduleHandler()->moduleExists('trash')) {
    return 'trash module is not enabled — nothing to do.';
  }
  $excluded = ['session', 'activity', 'class', 'program', 'program_subcategory'];
  $allBundles = array_keys(\Drupal::service('entity_type.bundle.info')->getBundleInfo('node'));
  $allowedBundles = array_values(array_diff($allBundles, $excluded));

  $config = \Drupal::configFactory()->getEditable('trash.settings');
  $enabled = $config->get('enabled_entity_types') ?? [];
  $enabled['node'] = $allowedBundles;
  $config->set('enabled_entity_types', $enabled)->save();

  return 'Trash now tracks node bundles: ' . implode(', ', $allowedBundles) . '. Excluded: ' . implode(', ', $excluded) . '.';
}

/**
 * Add sync window, incremental, delete safeguards, and canceled UX settings.
 */
function yusaopeny_ymca360_instudio_update_10001(): string {
  $defaults = [
    'sync.past_days' => 7,
    'sync.window_days' => 14,
    'sync.page_size' => 500,
    'sync.incremental' => 0,
    'sync.max_deletes_per_run' => 500,
    'sync.canceled_title_prefix' => 'CANCELED: ',
    'sync.canceled_publish_behavior' => 'follow_api',
  ];
  $config = \Drupal::configFactory()->getEditable('yusaopeny_ymca360_instudio.settings');
  $added = [];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
      $added[] = $key;
    }
  }
  $config->save();
  if (empty($added)) {
    return 'No settings added — all were already present.';
  }
  return 'Added settings: ' . implode(', ', $added) . '.';
}
